# Copy to .env and replace every value below with strong, unique secrets.
# Docker Compose reads .env for ${VAR} interpolation. NEVER commit a real .env.
#
# The app refuses to start if these are unset or left as a known placeholder
# (the "change-me" values below are rejected on purpose). Generate a strong
# secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

QARUNNER_SECRET_KEY=change-me
QARUNNER_ADMIN_PASSWORD=change-me

# dev only (docker-compose.dev.yml) — host directory tree that "link local
# suite" can reach. It is bind-mounted read-only at the SAME path inside the
# container so symlinks into external_tests resolve. Leave empty to default to
# ~/code, or narrow it to a single project root. Not used by the prod compose.
QARUNNER_PROJECTS_ROOT=

# Production compose (docker-compose.yml) runs the platform as the non-root `app`
# user, which must join the host's docker group to reach /var/run/docker.sock.
# Set this to that group's gid:
#   getent group docker | cut -d: -f3      # Linux
#   stat -c %g /var/run/docker.sock        # fallback
QARUNNER_DOCKER_GID=
