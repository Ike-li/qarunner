# Copy to .env and replace every value below with strong, unique secrets.
# Docker Compose reads .env for ${VAR} interpolation. NEVER commit a real .env.
#
# The app refuses to start if QARUNNER_SECRET_KEY / QARUNNER_ADMIN_PASSWORD are
# unset or left as a known placeholder ("change-me" is rejected on purpose).
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Required ─────────────────────────────────────────────────────────────────
QARUNNER_SECRET_KEY=change-me
QARUNNER_ADMIN_PASSWORD=change-me

# ── Paths ────────────────────────────────────────────────────────────────────
# QARUNNER_TESTS_ROOT=./external_tests/
# QARUNNER_ARTIFACTS_ROOT=./artifacts
# QARUNNER_DB_PATH=./artifacts/qarunner.db
# QARUNNER_ALLURE_BIN=allure
# QARUNNER_EXECUTABLE=         # empty → sys.executable at runtime

# ── Execution ────────────────────────────────────────────────────────────────
# QARUNNER_DEFAULT_TIMEOUT_SECONDS=1800
# QARUNNER_MAX_CONCURRENCY=4
# QARUNNER_MAX_INFLIGHT_RUNS_PER_USER=20   # per-user cap; admins exempt; 0 disables

# ── Regression view ──────────────────────────────────────────────────────────
# QARUNNER_FLAKY_MIN_OBSERVATIONS=4   # min observations before a case can be flagged flaky
# QARUNNER_FLAKY_FLIP_THRESHOLD=3     # pass<->fail flips required to flag flaky

# ── Docker executor ──────────────────────────────────────────────────────────
# QARUNNER_EXECUTOR_AUTOBUILD=true   # set false in production; pre-build image instead
# QARUNNER_PLAYWRIGHT_EXECUTOR_IMAGE=qarunner-playwright-executor:latest
# QARUNNER_EXECUTOR_EXTRA_READONLY_ROOTS=  # os.pathsep-separated allowlist for env directory mounts

# ── Auth ─────────────────────────────────────────────────────────────────────
# QARUNNER_ALGORITHM=HS256
# QARUNNER_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# QARUNNER_COOKIE_SECURE=false   # set true in production (HTTPS only)
# QARUNNER_ADMIN_USER=admin
# QARUNNER_LOGIN_THROTTLE_THRESHOLD=5      # failed logins per username|IP before lockout; 0 disables
# QARUNNER_LOGIN_THROTTLE_BASE_SECONDS=60  # first lockout duration (exponential backoff)
# QARUNNER_LOGIN_THROTTLE_MAX_SECONDS=900  # lockout ceiling
# QARUNNER_CORS_ORIGINS=                   # comma-separated origins; empty = same-origin only
# QARUNNER_TRUSTED_PROXIES=                # comma-separated reverse-proxy IPs whose forwarded headers are trusted

# ── AI failure diagnosis (optional) ──────────────────────────────────────────
# Empty QARUNNER_AI_API_KEY disables generation: endpoints return enabled:false
# and the AI Analysis tab still appears but shows an unconfigured message inside
# (the platform starts normally, unlike the required secrets above). provider
# selects the SDK — anthropic | openai. base_url allows a self-hosted gateway.
# POST is rate-limited per user (max_calls within window_seconds; 0 disables).
# QARUNNER_AI_PROVIDER=anthropic
# QARUNNER_AI_API_KEY=                 # empty → AI diagnosis disabled
# QARUNNER_AI_MODEL=claude-opus-4-8    # e.g. gpt-4o when QARUNNER_AI_PROVIDER=openai
# QARUNNER_AI_BASE_URL=                # optional self-hosted gateway/proxy endpoint
# QARUNNER_AI_ANALYSIS_MAX_LOG_BYTES=16384
# QARUNNER_AI_REQUEST_TIMEOUT_SECONDS=60
# QARUNNER_AI_POST_MAX_CALLS=10
# QARUNNER_AI_POST_WINDOW_SECONDS=60

# ── Resilience ───────────────────────────────────────────────────────────────
# QARUNNER_CRASH_RECOVERY_ON_STARTUP=true   # set false on all but one replica
# QARUNNER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# ── Clustering ───────────────────────────────────────────────────────────────
# QARUNNER_WORKER_NODE_ID=<hostname>   # defaults to socket.gethostname()

# ── dev only (docker-compose.dev.yml) ────────────────────────────────────────
# Host directory tree that "link local suite" can reach. Bind-mounted read-only
# at the SAME path inside the container so symlinks into external_tests resolve.
# Set to your projects root (e.g. ~/code on macOS, ~/projects on Linux).
# Falls back to ${HOME}/code if empty. Not used by the prod compose.
QARUNNER_PROJECTS_ROOT=

# ── Production compose (docker-compose.yml) ──────────────────────────────────
# The server runs as the non-root `app` user, which must join the host docker group
# to reach /var/run/docker.sock. Set to that group's gid:
#   getent group docker | cut -d: -f3      # Linux
#   stat -c %g /var/run/docker.sock        # fallback
QARUNNER_DOCKER_GID=

# Public-facing base URL for building absolute links in Feishu notification cards
# (e.g. https://qa.example.com). Leave empty to skip notifications entirely.
QARUNNER_PUBLIC_URL=
