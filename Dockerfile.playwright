FROM mcr.microsoft.com/playwright:v1.61.1-noble

WORKDIR /app

RUN npm install -g @playwright/test@1.61.1 \
    && npm cache clean --force

# Qarunner canonical reporter (M5, T-M5-PLAYWRIGHT-ADAPTER-001).
# Stdlib-only; no package dependencies — the image has @playwright/test global
# but this reporter must import nothing beyond core Node.
COPY src/qarunner/playwright_reporter/qarunner_canonical_reporter.js /opt/qarunner-adapter/
ENV PLAYWRIGHT_REPORTER=/opt/qarunner-adapter/qarunner_canonical_reporter.js
ENV QARUNNER_CASE_RESULTS_PATH=/workspace/.qarunner-results/case-results.json

# Keep a non-root baked default, even though DockerRunner overrides uid:gid at
# runtime so bind-mounted artifacts stay owned by the platform caller.
USER pwuser

CMD ["npx", "playwright", "--version"]
