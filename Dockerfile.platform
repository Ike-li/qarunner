# Stage 1: Build the React Frontend
FROM node:20-slim AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: Final Runtime Platform Image
FROM python:3.12-slim
WORKDIR /app

# Install system dependencies (Java JRE for Allure CLI, curl/wget, unzip, git, etc.).
# openjdk-21 (not 17): the python:3.12-slim base now tracks Debian trixie, which
# dropped openjdk-17-jre-headless. Allure 2.x runs on Java 21.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    wget \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Download and install Allure Commandline CLI (2.24.0)
RUN wget -q https://github.com/allure-framework/allure2/releases/download/2.24.0/allure-2.24.0.zip \
    && unzip -q allure-2.24.0.zip -d /opt/ \
    && ln -s /opt/allure-2.24.0/bin/allure /usr/bin/allure \
    && rm allure-2.24.0.zip

# Install dependencies from the lockfile for reproducible builds (DEP-2):
# `uv sync --frozen` installs the exact pinned versions and fails if the lock is
# stale, instead of letting `pip install .` re-resolve bare specifiers.
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev \
    && rm -rf /root/.cache
# Put the synced virtualenv first on PATH so CMD's uvicorn resolves to it.
ENV PATH="/app/.venv/bin:$PATH"

# Copy built frontend assets
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Expose FastAPI server port
EXPOSE 8000

# Set environment variables for runtime
ENV PORT=8000
ENV HOST=0.0.0.0
ENV QARUNNER_STATIC_ROOT=/app/frontend/dist

# Drop to a non-root user (DEP-1). Own /app so the app can write the SQLite DB
# and so the artifacts named volume inherits write access on first mount; the
# read-only external_tests mount stays world-readable.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /app/artifacts \
    && chown -R app:app /app
USER app

# Command to run uvicorn server
CMD ["uvicorn", "qarunner.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
